{
  "name": "bigdcompanies/phpmodbus",
  "keywords": ["phpmodbus","modbus"],
  "description": "PhpModbus with namespaces and updated to PHP 7",
  "license": "LGPL",
  "require": {
    "php": "^7.0|^8.0",
    "ext-sockets": "*"
  },
  "authors": [
    {
      "name": "Tobias Kluge"
    },
    {
      "name": "Honza Krakora",
      "email": "krakora.jan@googlemail.com"
    },
    {
      "name": "Ondřej Hruška",
      "email": "ondra@ondrovo.com"
    },
    {
      "name": "Erich Simmons",
      "email": "public@erichsimmons.com"
    },
    {
      "name": "Daniel Buenrrostro",
      "email": "daniel@danielbuenrrostro.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "PHPModbus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.3",
    "pestphp/pest": "^2.36"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
